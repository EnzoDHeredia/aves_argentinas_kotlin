<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/insets_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_background">

    <!-- Barra superior / Toolbar en card consistente con LearningGameActivity -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_small"
        android:layout_marginEnd="@dimen/screen_padding_small"
        android:layout_marginTop="@dimen/screen_padding_small"
        app:cardBackgroundColor="@color/brand_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/brand_outline"
        app:strokeWidth="1dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/sound_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_primary"
            app:navigationContentDescription="@string/back">

            <TextView
                android:id="@+id/sound_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingTop="@dimen/screen_padding_small"
                android:paddingBottom="@dimen/screen_padding_small"
                android:text="@string/sound_identification_title"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:accessibilityHeading="true" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.card.MaterialCardView>

    <!-- Contenedor fijo de estado, errores y acción principal fuera del área desplazable -->
    <LinearLayout
        android:id="@+id/layoutFixedControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="8dp">

        <!-- Área de estado y progreso (RF-5, RF-6, RF-8) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/brand_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/brand_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgStatusIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/brand_primary"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/sound_status_ready"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:accessibilityLiveRegion="polite" />

                <!-- Temporizador de tiempo monotónico transcurrido (RF-4, RF-5) -->
                <TextView
                    android:id="@+id/txtTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- Indicador indeterminado para preparación / detención -->
                <ProgressBar
                    android:id="@+id/progressBarIndeterminate"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="@color/brand_primary"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de errores y rationale de permisos (RF-4, RF-10, RF-11) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/brand_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/expert_warning_tint"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnErrorAction"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/brand_primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón de acción principal: Escuchar / Detener -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMainAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginBottom="4dp"
            android:text="@string/sound_action_listen"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/brand_on_primary"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconSize="22dp"
            app:iconTint="@color/brand_on_primary"
            app:iconPadding="8dp" />

    </LinearLayout>

    <!-- Único desplazamiento vertical: RecyclerView con ConcatAdapter (Header, Resultados, Footer) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="4dp"
        android:paddingBottom="16dp" />

</LinearLayout>
